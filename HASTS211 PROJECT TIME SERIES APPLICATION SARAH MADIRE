        "ax2.plot(aapl['Prob_High_Vol'], label='Prob(High Volatility Regime)', color='red')\n",
        "ax2.fill_between(aapl.index, 0, aapl['Prob_High_Vol'], color='red', alpha=0.2)\n",
        "ax2.set_title('Smoothed Probability of High Volatility Regime')\n",
        "ax2.set_ylim(0, 1.1)\n",
        "ax2.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
