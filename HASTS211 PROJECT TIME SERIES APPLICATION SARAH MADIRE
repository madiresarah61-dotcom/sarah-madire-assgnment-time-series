        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from statsmodels.tsa.regime_switching.markov_regression import MarkovRegression\n",
        "\n",
        "# 1. Download AAPL data (2018-2025)\n",
        "ticker = 'AAPL'\n",
        "aapl = yf.download(ticker, start='2018-01-01', end='2025-12-31', progress=False)\n",
        "\n",
        "# 2. Calculate Log Returns\n",
        "aapl['Log_Return'] = np.log(aapl['Close'] / aapl['Close'].shift(1))\n",
        "data = aapl['Log_Return'].dropna()\n",
        "\n",
        "# 3. Fit Markov Switching Model (2 regimes)\n",
        "# Regime 0: Low Volatility, Regime 1: High Volatility\n",
        "model = MarkovRegression(data, k_regimes=2, switching_variance=True)\n",
        "res = model.fit()\n",
        "\n",
        "# 4. Extract Probabilities\n",
        "aapl['Prob_High_Vol'] = np.nan\n",
        "aapl.loc[data.index, 'Prob_High_Vol'] = res.smoothed_marginal_probabilities[1]\n",
        "\n",
        "# 5. Visualization\n",
        "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10), sharex=True)\n",
